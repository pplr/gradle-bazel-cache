# Gradle
.gradle/
# NOT a bare `build/`: that matches any directory of that name at any depth,
# including src/main/proto/build/ where the vendored REAPI protos live. Ignoring
# those meant CI had nothing to generate from while local builds kept working.
/build/
/*/build/
/*/*/build/
/*/*/*/build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Local build cache spool (created by this plugin at runtime)
.gradle/bazel-cache-spool/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
out/

# OS
.DS_Store
Thumbs.db

# Reference material for the talk this project is based on (transcript and
# slides). Third-party conference material -- kept locally, never redistributed.
conf/

# Local overrides / secrets
local.properties
*.local
secring.gpg
